# Hosted TCA Server: install a Metadata: read GitHub App on each project repository.
# Never send a member's gh auth token to this server.
TCA_AUTH_MODE=github
DATABASE_URL=replace-with-postgres-url
TCA_ALLOWED_HOSTS=replace-with-tca-server-host
TCA_GITHUB_APP_ID=replace-with-app-id
TCA_GITHUB_APP_PRIVATE_KEY=replace-with-app-private-key-pem

# Optional compatibility integration webhook only. Standard Claim submission
# uses MCP directly and does not need a webhook or GITHUB_TOKEN.
# GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
# GITHUB_TOKEN=replace-with-server-controlled-read-only-token
