# TCA Server -----------------------------------------------------------------

# SQL 数据库连接串。托管部署可以用 Neon/Postgres；自托管也可以换成自己的 Postgres。
# 本地不设置时，TCA 使用 SQLite。
DATABASE_URL=

# A/M 调用 /mcp 和 /api 时使用的 Bearer token。
# Server 用这个值校验请求；A/M 本机也要设置同名环境变量。
TCA_API_TOKEN=replace-with-random-token

# 只有匹配此前缀的 GitHub push 分支会被当作 Claim。
# 必须和被测 repo 的 .tca/project.yaml 保持一致。
TCA_CLAIM_BRANCH_PREFIX=tca/claim/

# GitHub webhook HMAC secret。
# 必须和 GitHub Settings -> Webhooks 里的 Secret 完全一致。
GITHUB_WEBHOOK_SECRET=replace-with-random-secret

# TCA Server 读取 GitHub repo 中 .tca/claim.yaml 的 token。
# 私有 repo 需要；当前只需要读取 Claim 文件。
GITHUB_TOKEN=replace-with-fine-grained-token

# Local development ----------------------------------------------------------

# 本地 SQLite 文件路径。只有 DATABASE_URL 为空时使用。
TCA_DATABASE=tca.db

# Optional server knobs ------------------------------------------------------

GITHUB_API_URL=https://api.github.com
TCA_CLAIM_PATH=.tca/claim.yaml
TCA_ALLOWED_HOSTS=127.0.0.1,localhost,tca-ten.vercel.app
