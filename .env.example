# TCA Server deployment ------------------------------------------------------

# Required for any deployed TCA Server.
# A/M clients use this as "Authorization: Bearer <token>" for /mcp and /api.
TCA_API_TOKEN=replace-with-random-token

# Required for deployed state persistence.
# Local development may leave this empty and use SQLite instead.
DATABASE_URL=

# Required when serving MCP from a deployed host.
# Set this to the hostname users will call. Do not include https://.
# Example: TCA_ALLOWED_HOSTS=tca-ten.vercel.app
TCA_ALLOWED_HOSTS=replace-with-tca-server-host

# GitHub claim adapter -------------------------------------------------------

# Leave these empty while only deploying the TCA Server itself.
# Set them when a separate tested repo should send Claim webhooks to this server.

# GitHub webhook HMAC secret. The tested repo webhook must use the same value.
GITHUB_WEBHOOK_SECRET=

# Token used by TCA Server to read .tca/claim.yaml from tested repos.
# Public repos can work without it, but private repos need a fine-grained token.
GITHUB_TOKEN=

# Usually leave these defaults unchanged.
TCA_CLAIM_BRANCH_PREFIX=tca/claim/
TCA_CLAIM_PATH=.tca/claim.yaml
GITHUB_API_URL=https://api.github.com

# Local development only -----------------------------------------------------

# SQLite file path used only when DATABASE_URL is empty.
TCA_DATABASE=tca.db

# Local uvicorn settings used by `uv run tca-app`.
TCA_HOST=127.0.0.1
TCA_PORT=8000
