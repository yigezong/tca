# TCA Server deployment

# Shared Bearer token generated once by the TCA Server operator.
# Authorized A/M clients receive this same value; members do not generate their own.
TCA_API_TOKEN=replace-with-random-token

# Postgres connection string for deployed state.
DATABASE_URL=replace-with-postgres-url

# MCP Host header allowlist. Use the TCA Server hostname, without https://.
TCA_ALLOWED_HOSTS=replace-with-tca-server-host

# Optional: enable GitHub Claim ingestion and automatic integration confirmation.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
GITHUB_TOKEN=replace-with-github-token
