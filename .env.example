# 本地不设置 DATABASE_URL 时使用 SQLite；Vercel 由 Neon integration 注入。
DATABASE_URL=
TCA_DATABASE=tca.db

TCA_API_TOKEN=replace-with-random-token
TCA_COORDINATION_MODE=external
TCA_CLAIM_BRANCH_PREFIX=tca/claim/

GITHUB_WEBHOOK_SECRET=replace-with-random-secret
GITHUB_TOKEN=replace-with-fine-grained-token
TCA_PUBLISH_GIT_DECISIONS=0

# 仅使用本地 bare Git hook 时设置。
TCA_WEBHOOK_SECRET=
