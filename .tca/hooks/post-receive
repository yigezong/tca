#!/bin/sh
set -eu

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$hook_dir/tca.env"
zero=0000000000000000000000000000000000000000

while read -r old_revision new_revision ref_name; do
    [ "$new_revision" = "$zero" ] && continue
    case "$ref_name" in
        refs/heads/tca/claim/*) ;;
        *) continue ;;
    esac

    claim_yaml=$(git show "$new_revision:.tca/claim.yaml")
    digest=$(printf %s "$claim_yaml" | openssl dgst -sha256 -hmac "$TCA_WEBHOOK_SECRET" -hex | sed 's/^.* //')
    curl --fail --silent --show-error \
        -X POST "$TCA_WEBHOOK_URL" \
        -H "Content-Type: application/yaml" \
        -H "X-TCA-Signature: sha256=$digest" \
        -H "X-TCA-Repository: $TCA_PROJECT_ID" \
        -H "X-TCA-Ref: $ref_name" \
        --data-binary "$claim_yaml"
done
